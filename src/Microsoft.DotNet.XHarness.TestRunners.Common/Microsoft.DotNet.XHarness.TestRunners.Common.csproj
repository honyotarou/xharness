<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(XHarnessNetTFMs)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <!-- Mono.Options is apparently not strong-name signed -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Options" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Microsoft.DotNet.XHarness.Common\Networking\TcpListenerAddressResolver.cs"
             Link="TcpListenerAddressResolver.cs" />
    <Compile Include="..\Microsoft.DotNet.XHarness.Common\Networking\TcpStreamLimits.cs"
             Link="TcpStreamLimits.cs" />
    <Compile Include="..\Microsoft.DotNet.XHarness.Common\CLI\CliTokenValidator.cs"
             Link="CliTokenValidator.cs" />
    <Compile Include="..\Microsoft.DotNet.XHarness.Common\Utilities\HostPathSecurity.cs"
             Link="HostPathSecurity.cs" />
    <Compile Include="..\Microsoft.DotNet.XHarness.Common\XmlResultJargon.cs"
             Link="XmlResultJargon.cs" />
    <Compile Include="..\Microsoft.DotNet.XHarness.iOS.Shared\Execution\EnviromentVariables.cs"
             Link="EnvironmentVariables.cs" />
  </ItemGroup>

</Project>
